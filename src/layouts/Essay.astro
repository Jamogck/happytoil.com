---
import type { CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Figure from '../components/Figure.astro';
import { formatDate } from '../site';

interface Props {
  entry: CollectionEntry<'writing'>;
}

const { entry } = Astro.props;
const { title, standfirst, summary, published, updated, image, imageAlt, draft } = entry.data;
---

<Base
  title={title}
  description={summary}
  type="article"
  publishedTime={published}
>
  <article class="frame">
    <div class="grid section--tight">
      <div class="col-intro">
        <PageHeader
          label={draft ? 'Draft' : 'Writing'}
          title={title}
          standfirst={standfirst}
          meta={updated
            ? `${formatDate(published)} · revised ${formatDate(updated)}`
            : formatDate(published)}
        />
      </div>
    </div>

    {
      image && (
        <div class="grid">
          <div class="col-wide">
            <Figure src={image} alt={imageAlt ?? ''} width="wide" loading="eager" />
          </div>
        </div>
      )
    }

    <div class="grid section--tight section--flush">
      <div class="col-reading">
        <div class="prose prose--with-margins">
          <slot />
        </div>
      </div>
    </div>

    <div class="grid section--tight">
      <div class="col-reading">
        <hr class="rule" />
        <p class="meta essay__back">
          <a href="/writing/">All writing</a>
        </p>
      </div>
    </div>
  </article>
</Base>

<style>
  .essay__back {
    margin-top: var(--space-m);
  }
</style>
