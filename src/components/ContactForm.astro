---
import { site } from '../site';

/**
 * A plain POST form. It renders only when `site.formEndpoint` is set, so the
 * site never ships a form that quietly goes nowhere. Until then the contact
 * page shows the email address, which works just as well.
 *
 * Any endpoint that accepts a normal form POST will do — a Cloudflare Pages
 * Function, Formspree, Netlify Forms, your own handler.
 */
const endpoint = site.formEndpoint;
---

{
  endpoint && (
    <form class="contact-form" method="POST" action={endpoint}>
      <label class="form-field">
        <span class="form-field__label">Your name</span>
        <input type="text" name="name" autocomplete="name" required />
      </label>

      <label class="form-field">
        <span class="form-field__label">Email</span>
        <input type="email" name="email" autocomplete="email" required />
      </label>

      <label class="form-field">
        <span class="form-field__label">The business</span>
        <span class="form-field__help">
          What it does, roughly how big it is, and how long it’s been going.
        </span>
        <input type="text" name="business" />
      </label>

      <label class="form-field">
        <span class="form-field__label">What’s going on</span>
        <span class="form-field__help">
          The situation as you’d describe it to someone who knows the industry but not
          your company. No need to package it up.
        </span>
        <textarea name="message" required></textarea>
      </label>

      {/* Quiet spam trap. Real people leave it empty. */}
      <div class="contact-form__trap" aria-hidden="true">
        <label>
          Leave this field empty
          <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
        </label>
      </div>

      <button class="button" type="submit">
        Send it
      </button>
    </form>
  )
}

<style>
  .contact-form {
    max-width: 32rem;
    margin-top: var(--space-l);
  }

  .contact-form__trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
</style>
