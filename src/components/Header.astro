---
import Logomark from './Logomark.astro';
import { site, nav } from '../site';

const path = Astro.url.pathname;

function isCurrent(href: string): boolean {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(href);
}

interface Props {
  showNav?: boolean;
}

const { showNav = true } = Astro.props;
---

<header class="site-header">
  <div class="frame site-header__inner">
    <a class="identity" href="/" aria-label={`${site.name} — home`}>
      <Logomark />
      <span class="identity__name">Happy Toil</span>
    </a>

    {
      showNav && (
        <nav class="site-nav" aria-label="Primary">
          {nav.map((item) => (
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))}
        </nav>
      )
    }
  </div>
</header>
