---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * A photograph or diagram with a caption. Captions should add information —
 * what this is, where it was, why it mattered — not restate the image.
 */
interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /** A quiet numeral for figures referred to in the text: "Fig. 3". */
  number?: string;
  /** 'reading' sits in the text column; 'wide' and 'full' break out. */
  width?: 'reading' | 'wide' | 'full';
  /** Rendered width in px for the largest layout this figure will occupy. */
  sizes?: string;
  loading?: 'lazy' | 'eager';
  /** Pairs with a listing thumbnail's `transitionName` — see Thumb.astro. */
  transitionName?: string;
}

const {
  src,
  alt,
  caption,
  number,
  width = 'reading',
  sizes = '(min-width: 64em) 46rem, 100vw',
  loading = 'lazy',
  transitionName,
} = Astro.props;
---

<figure class:list={['figure', `figure--${width}`]}>
  <div class="figure__frame" transition:name={transitionName}>
    <Image src={src} alt={alt} sizes={sizes} widths={[480, 800, 1200, 1800]} loading={loading} />
  </div>
  {
    (caption || number) && (
      <figcaption>
        {number && <span class="figure__number">{number}&nbsp;&nbsp;</span>}
        {caption}
      </figcaption>
    )
  }
</figure>

<style>
  .figure--full {
    margin-inline: calc(var(--gutter) * -1);
  }

  .figure--full figcaption {
    padding-inline: var(--gutter);
  }

  @media (min-width: 64em) {
    .figure--wide {
      width: min(58rem, calc(100% + 12rem));
    }
  }
</style>
